# Copiá este archivo como .env y completalo. El .env NUNCA se sube a git ni se comparte.

# Token del bot (Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=

# OPCIONAL. El bot funciona en todos los servidores donde lo agregues.
# Solo hace falta si venís de la versión vieja (un solo servidor): ese servidor recibe la configuración guardada.
GUILD_ID=

# OPCIONAL. Carpeta donde se guardan config.json y las transcripciones (por defecto, ./data)
# DATA_DIR=

# OPCIONAL. Muestra el detalle completo (stack) de los errores en la consola
# DEBUG=1

# OPCIONAL. Puente con el plugin de staff de Minecraft (proyecto aparte: ../minecraft-plugin). Sin
# esto, el puente queda apagado. El plugin usa el mismo valor en "bot-api.secret" de su config.yml.
# El host tiene que exponer MC_BRIDGE_PORT a internet para que el server de Minecraft lo alcance.
# MC_BRIDGE_SECRET=
# MC_BRIDGE_PORT=8787
